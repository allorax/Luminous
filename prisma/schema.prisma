generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Alert {
  id        String   @id @default(cuid())
  symbol    String
  price     Float
  type      String   // 'price' or 'volume'
  email     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Portfolio {
  id        String   @id @default(cuid())
  symbol    String
  quantity  Float
  avgPrice  Float
  userId    String
  createdAt DateTime @default(now())
}
